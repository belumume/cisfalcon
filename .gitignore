# models + large benchmark data (see DATA.md for sources)
models/
*.h5

# exclude data/ contents but keep the small curated demo JSONs the Dockerfile needs
data/*
!data/gosai_designed/
data/gosai_designed/*
!data/gosai_designed/hero.json
!data/gosai_designed/batch_example.json

# exclude big benchmark CSVs, keep the small curated result/economics files
*.csv
!docs/cisfalcon_triage_economics.csv
!screenaudit/screenaudit_result.json

# python
__pycache__/
*.pyc
.venv/
.venv-tf/
.pytest_cache/
.ruff_cache/

# env / secrets
.env
.env.*
*.key
*.pem

# runtime caches (regenerable)
webapp/backend/jaspar_cache/_new/
screenaudit/cache/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
webapp/backend/static/_pre-fable5-backup/
.playwright-mcp/
webapp/backend/_verify_proxy.py

# local audit scratch (not part of the published artifact)
.audit-findings/

# result artifacts must never be silently dropped by the broad data/ ignore
!data/gosai_designed/*.json
# ...but a local re-run's output is not a result artifact. closed_loop_powered.py writes here by
# default so that reproducing it cannot overwrite the committed evidence; without this line the
# negation above would track that scratch file.
data/gosai_designed/*.local.json

# agent/session scratch: contains absolute local paths (username). Never publish.
.claude/
.audit-findings-pass2/
.audit-findings-pass3/

# Browser demo (webdemo/): everything the build generates. The page is assembled from the
# served frontend by webdemo/build.py, and the 120MB of converted weights come from Zenodo,
# so neither is committed; a clone stays small and the copy can never drift from the original.
webdemo/models/
webdemo/index.html
webdemo/app.js
webdemo/styles.css
webdemo/jaspar/
webdemo/data/
node_modules
